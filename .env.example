# API Configuration
API_KEY=honeypot-secret-2026
PORT=8000
HOST=0.0.0.0

# ========================================
# LLM Provider Configuration
# ========================================
# Choose one: anthropic (recommended), gemini, or openai
LLM_PROVIDER=anthropic

# ========================================
# Anthropic Configuration (Recommended - Claude Haiku 4.5) - UNLIMITED Keys!
# ========================================
# Add as many keys as you need! System automatically detects all ANTHROPIC_API_KEY* variables
# This is useful for:
# - Rate limit avoidance (automatic key rotation)
# - High traffic handling (load balancing)
# - Redundancy and fault tolerance
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_API_KEY_2=your-second-anthropic-key-here
ANTHROPIC_API_KEY_3=your-third-anthropic-key-here
ANTHROPIC_API_KEY_4=your-fourth-anthropic-key-here
# Add more following the same pattern: ANTHROPIC_API_KEY_5, ANTHROPIC_API_KEY_6, etc.
# No code changes needed - just add more environment variables!
ANTHROPIC_MODEL=claude-haiku-4.5-20250110

# ========================================
# Google Gemini Configuration - UNLIMITED API Keys Support!
# ========================================
# Add as many keys as you need! System automatically detects all GOOGLE_API_KEY* variables
# This is useful for:
# - Rate limit avoidance (key rotation)
# - High traffic handling
# - Redundancy
GOOGLE_API_KEY=your-primary-gemini-key-here
GOOGLE_API_KEY_2=your-second-gemini-key-here
GOOGLE_API_KEY_3=your-third-gemini-key-here
GOOGLE_API_KEY_4=your-fourth-gemini-key-here
# Add more keys following the same pattern: GOOGLE_API_KEY_5, GOOGLE_API_KEY_6, etc.
# No code changes needed - just add more environment variables!
GEMINI_MODEL=gemini-2.0-flash-exp

# ========================================
# OpenAI Configuration (Alternative) - UNLIMITED Keys!
# ========================================
# Add as many keys as you need! System automatically detects all OPENAI_API_KEY* variables
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_API_KEY_2=your-second-openai-key-here
OPENAI_API_KEY_3=your-third-openai-key-here
OPENAI_API_KEY_4=your-fourth-openai-key-here
# Add more following the same pattern: OPENAI_API_KEY_5, OPENAI_API_KEY_6, etc.
# No code changes needed - just add more environment variables!
OPENAI_MODEL=gpt-4-turbo-preview

# ========================================
# GUVI Hackathon Configuration
# ========================================
GUVI_CALLBACK_URL=https://hackathon.guvi.in/api/updateHoneyPotFinalResult

# ========================================
# Session Management
# ========================================
SESSION_TIMEOUT_MINUTES=30
MAX_MESSAGES_PER_SESSION=50

# ========================================
# Performance Tuning
# ========================================
CACHE_MAX_SIZE=500
LLM_MAX_TOKENS_DETECTION=1500
LLM_MAX_TOKENS_RESPONSE=2000
LLM_REQUEST_TIMEOUT=5

# ========================================
# Scam Detection Thresholds
# ========================================
SCAM_DETECTION_THRESHOLD=0.5
SCAM_SCORE_THRESHOLD=2

# ========================================
# Debug Mode
# ========================================
INCLUDE_DEBUG_INFO=false

# ========================================
# Redis Configuration (Optional - not required for Render)
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
USE_REDIS=false
