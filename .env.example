# API Configuration
API_KEY=honeypot-secret-2026
PORT=8000
HOST=0.0.0.0

# ========================================
# LLM Provider Configuration
# ========================================
# PRODUCTION: Using Gemini only
LLM_PROVIDER=gemini

# ========================================
# Google Gemini Configuration (Production Provider) - UNLIMITED API Keys Support!
# ========================================
# Add as many keys as you need! System automatically detects all GOOGLE_API_KEY* variables
# Get your free API keys at: https://aistudio.google.com/app/apikey
# This is useful for:
# - Rate limit avoidance (key rotation)
# - High traffic handling (160+ requests/day with 8 keys)
# - Redundancy
GOOGLE_API_KEY=your-primary-gemini-key-here
GOOGLE_API_KEY_2=your-second-gemini-key-here
# GOOGLE_API_KEY_3=your-third-gemini-key-here  # Comment out invalid keys
# GOOGLE_API_KEY_4=your-fourth-gemini-key-here
GOOGLE_API_KEY_5=your-fifth-gemini-key-here
GOOGLE_API_KEY_6=your-sixth-gemini-key-here
GOOGLE_API_KEY_7=your-seventh-gemini-key-here
GOOGLE_API_KEY_8=your-eighth-gemini-key-here
GOOGLE_API_KEY_9=your-ninth-gemini-key-here
GOOGLE_API_KEY_10=your-tenth-gemini-key-here
# Add more keys following the same pattern: GOOGLE_API_KEY_11, GOOGLE_API_KEY_12, etc.
# No code changes needed - just add more environment variables!
# Valid models (Feb 2026): gemini-2.5-flash, gemini-1.5-pro, gemini-1.0-pro, gemini-pro
GEMINI_MODEL=gemini-2.5-flash

# ========================================
# GUVI Hackathon Configuration
# ========================================
GUVI_CALLBACK_URL=https://hackathon.guvi.in/api/updateHoneyPotFinalResult

# ========================================
# Session Management
# ========================================
SESSION_TIMEOUT_MINUTES=30
MAX_MESSAGES_PER_SESSION=50

# ========================================
# Performance Tuning (Optimized for Hackathon)
# ========================================
CACHE_MAX_SIZE=1000
LLM_MAX_TOKENS_DETECTION=500
LLM_MAX_TOKENS_RESPONSE=800
LLM_REQUEST_TIMEOUT=5
LLM_TEMPERATURE=0.1

# Fast-path optimization (10x faster for short messages)
ENABLE_FAST_PATH=true
FAST_PATH_THRESHOLD=6

# ========================================
# Security Settings
# ========================================
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_SIZE=1048576

# ========================================
# Scam Detection Thresholds
# ========================================
SCAM_DETECTION_THRESHOLD=0.5
SCAM_SCORE_THRESHOLD=2

# ========================================
# Debug Mode
# ========================================
INCLUDE_DEBUG_INFO=false

# ========================================
# Redis Configuration (Optional - not required for Render)
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
USE_REDIS=false
